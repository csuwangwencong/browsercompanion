{
  "manifest_version": 3,
  "name": "BrowserCompanion",
  "version": "1.1.0",
  "description": "AI companion browser control assistant",
  "permissions": ["sidePanel", "activeTab", "tabs", "storage", "webNavigation"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://music.163.com/*",
    "https://www.bilibili.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://music.163.com/*", "https://www.bilibili.com/*"],
      "js": ["main-world/media-probe.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://music.163.com/*", "https://www.bilibili.com/*"],
      "js": ["content/adapters/netease-player.js", "content/bridge.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/readers/generic-page-reader.js", "content/read-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Open BrowserCompanion"
  }
}
