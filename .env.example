# MiMo API Configuration
MIMO_ENDPOINT=https://api.xiaomimimo.com/v1/chat/completions
MIMO_API_KEY=your-mimo-api-key-here
MIMO_MODEL=mimo-v2.5-pro

# Agent URLs (Local Development)
MUSIC_AGENT_URL=http://127.0.0.1:8001
VIDEO_AGENT_URL=http://127.0.0.1:8002
READING_AGENT_URL=http://127.0.0.1:8003
BROWSER_EXECUTION_URL=http://127.0.0.1:8000/internal/browser/execute
BROWSER_READ_URL=http://127.0.0.1:8000/internal/browser/read

# Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Service Tokens (change in production)
EXTENSION_SESSION_TOKEN=your-extension-token
BROWSER_EXECUTION_SERVICE_TOKEN=your-browser-execution-token

# Timeout Configuration (seconds)
A2A_TIMEOUT_SECONDS=80
CHAT_TASK_BUDGET_SECONDS=90
BROWSER_EXECUTION_TIMEOUT_SECONDS=10
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_READ_TIMEOUT_SECONDS=60
MUSIC_TASK_BUDGET_SECONDS=75
VIDEO_TASK_BUDGET_SECONDS=75
READING_TASK_BUDGET_SECONDS=90
